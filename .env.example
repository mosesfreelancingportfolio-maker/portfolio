# Contact form email delivery (Brevo)
# https://app.brevo.com/api-keys
BREVO_API_KEY=

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=

# Email address used as the sender (must be verified in your Brevo account)
CONTACT_FROM_EMAIL=

# Canonical site URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: PostgreSQL connection string (only if persistent data is added)
# DATABASE_URL=